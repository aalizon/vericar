# ==============================================================================
# VériCar Europe — Configuration Serveur SaaS
# Copier vers `.env` (racine) ou `server/.env` pour le développement local.
# Les variables d'environnement système/conteneur ont toujours la priorité.
# ==============================================================================

# --- Serveur & Base de données ---
NODE_ENV=development
PORT=3001
# Chemin SQLite explicite (par défaut : server/data/vericar.db ; en Docker/PaaS : /app/data/vericar.db)
# DB_PATH=/app/data/vericar.db
# Répertoire de données alternatif (utilisé si DB_PATH n'est pas défini -> <DATA_DIR>/vericar.db)
# DATA_DIR=/app/data
APP_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173,http://localhost:3001
TRUST_PROXY=1

# --- Authentification, Sessions & Admin ---
SESSION_TTL_DAYS=7
SIGNUP_BONUS_CREDITS=1
# Optionnel : crée ou promeut automatiquement un compte administrateur au démarrage
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Facturation : Stripe (production) ou Mode Sandbox (tests) ---
# Si STRIPE_SECRET_KEY est défini, le mode Stripe est actif et le mode Sandbox est
# strictement désactivé (HTTP 403). Sans clé Stripe, le mode Sandbox est actif sauf si false.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ALLOW_SANDBOX_BILLING=true

# --- Protection anti-abus (multiplicateur borné [1..5] en production) ---
RATE_LIMIT_MAX_MULTIPLIER=1

# --- Mentions légales publiques (exposées par GET /api/config/public) ---
LEGAL_PUBLISHER_NAME=VériCar Europe SAS
LEGAL_CONTACT_EMAIL=contact@vericar-europe.eu
LEGAL_HOST_PROVIDER=Hébergement Cloud UE

# --- Connecteurs Open Data sans clé (actifs par défaut) ---
# - Décodage VIN ISO 3779 (local) + NHTSA vPIC (live)
# - Pays-Bas Open Data RDW (5 datasets CC0 live)
# - France RappelConso Open Data (live)
# - NHTSA Safety Recalls (live)

# --- Connecteurs gouvernementaux gratuits (clé API requise) ---
# Royaume-Uni DVSA MOT History (https://documentation.history.mot.api.gov.uk/)
UK_MOT_API_KEY=
UK_MOT_CLIENT_ID=
UK_MOT_CLIENT_SECRET=
UK_MOT_TOKEN_URL=

# Norvège Statens Vegvesen (https://www.vegvesen.no/fag/teknologi/apne-data/)
NO_VEGVESEN_API_KEY=

# --- Connecteurs commerciaux B2B (France SIV, Belgique Car-Pass, Allemagne DAT) ---
FR_SIV_API_KEY=
FR_SIV_API_URL=
BE_CARPASS_API_KEY=
DE_DAT_API_KEY=
